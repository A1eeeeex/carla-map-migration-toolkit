{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/carla-map-migration-toolkit/route-plan.schema.json",
  "title": "Immutable CARLA map migration route plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "route", "created_at", "workspace_sha256", "input_fingerprints", "environment_fingerprints", "steps", "blocked_reasons", "plan_sha256"],
  "properties": {
    "schema_version": {"const": "1.5.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "route": {"enum": ["roadrunner-to-source-carla", "source-carla-to-package-carla", "source-carla-to-ue427"]},
    "created_at": {"type": "string", "format": "date-time"},
    "workspace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_fingerprints": {"type": "array", "items": {"type": "object"}},
    "environment_fingerprints": {"type": "array", "items": {"type": "object"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "type", "execution_context", "read_paths", "write_paths", "assets", "expected_changes", "risk", "backup", "verify", "rollback"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "type": {"enum": ["AUTO", "EDITOR_CHECKPOINT", "REVIEW_REQUIRED", "BLOCKED"]},
          "execution_context": {"enum": ["host-cpython", "source-unreal-python", "ue427-unreal-python", "carla-client-python", "shell-build"]},
          "read_paths": {"type": "array", "items": {"type": "string"}},
          "write_paths": {"type": "array", "items": {"type": "string"}},
          "assets": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}},
          "expected_changes": {"type": "array", "items": {"type": "string"}},
          "risk": {"enum": ["low", "medium", "high"]},
          "backup": {"type": "object"},
          "verify": {"type": "array", "items": {"type": "string"}},
          "rollback": {"type": "array", "items": {"type": "string"}}
        },
        "allOf": [
          {
            "if": {"properties": {"step_id": {"const": "SRC2UE427.CLASSIFY_DEPS"}}, "required": ["step_id"]},
            "then": {"properties": {"assets": {"items": {"$ref": "#/$defs/dependency_action"}}}}
          }
        ]
      }
    },
    "blocked_reasons": {"type": "array", "items": {"type": "string"}},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "dependency_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_object", "classification", "target_strategy", "referencers", "migration_action", "verification", "rollback", "residual_risk"],
      "properties": {
        "source_object": {"type": ["string", "null"]},
        "classification": {"enum": ["portable", "localizable", "replaceable", "remove", "blocked", "unknown"]},
        "target_strategy": {"type": ["string", "null"]},
        "referencers": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "migration_action": {"type": ["string", "null"]},
        "verification": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rollback": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "residual_risk": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"classification": {"enum": ["portable", "localizable", "replaceable", "remove"]}},
            "required": ["classification"]
          },
          "then": {
            "properties": {
              "source_object": {"type": "string", "minLength": 1},
              "target_strategy": {"type": "string", "minLength": 1},
              "migration_action": {"type": "string", "minLength": 1},
              "verification": {"minItems": 1},
              "rollback": {"minItems": 1},
              "residual_risk": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  }
}
