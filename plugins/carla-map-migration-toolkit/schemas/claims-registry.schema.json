{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/carla-map-migration-toolkit/claims-registry.schema.json",
  "title": "Evidence-backed public claims registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "claims", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "route",
          "text",
          "required_evidence_level",
          "status",
          "test_ids",
          "evidence_artifacts",
          "verified_runs",
          "supported_stacks",
          "limitations"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^C-[A-Z0-9-]+$"},
          "route": {
            "enum": [
              "plugin",
              "shared",
              "roadrunner-to-source-carla",
              "source-carla-to-package-carla",
              "source-carla-to-ue427"
            ]
          },
          "text": {"type": "string", "minLength": 1},
          "required_evidence_level": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5"]},
          "status": {
            "enum": [
              "planned",
              "implemented",
              "maintainer-verified",
              "community-verified",
              "experimental",
              "unsupported",
              "unknown"
            ]
          },
          "test_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "evidence_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "verified_runs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "supported_stacks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "environment_sha256"],
              "properties": {
                "run_id": {"type": "string", "minLength": 1},
                "environment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {
            "if": {
              "properties": {"status": {"enum": ["maintainer-verified", "community-verified"]}},
              "required": ["status"]
            },
            "then": {
              "properties": {
                "verified_runs": {"minItems": 1},
                "supported_stacks": {"minItems": 1}
              }
            }
          }
        ]
      }
    },
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
